# Shared, non-secret defaults. Copy this file to .env for local overrides.
# Never commit a populated .env or any service token.
# WANDB_API_KEY=  # Prefer `wandb login`; uncomment only for non-interactive jobs.
WANDB_PROJECT=aims-predictive-evaluation
WANDB_ENTITY=agrgnn-kth-royal-institute-of-technology
WANDB_MODE=online

# Each collaborator authenticates with `modal setup`; do not share Modal tokens.
MODAL_ENVIRONMENT=main
